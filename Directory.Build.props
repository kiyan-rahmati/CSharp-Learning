<Project>
  <!-- Applies to every project in this repository.
       Run `dotnet --version` and set TargetFramework to match your SDK:
       8.x -> net8.0, 9.x -> net9.0, 10.x -> net10.0 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
